# Supabase (add after your project is created)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-side notification webhook for receiving exceptions.
# This can later point to a Supabase Edge Function, n8n workflow, Teams/Slack bridge,
# or a dedicated email service.
RECEIVING_NOTIFICATION_WEBHOOK_URL=

# Comma-separated admin recipients for future email notifications.
RECEIVING_ADMIN_EMAILS=
